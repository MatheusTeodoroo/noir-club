{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noir-club",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The same Worker serves the built site (apps/web/dist) and the room API.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "PAIRING", "class_name": "PairingObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject", "PairingObject"] }]
  // Optional secrets for Cloudflare Realtime TURN: TURN_KEY_ID, TURN_KEY_API_TOKEN
}
