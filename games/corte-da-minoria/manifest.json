{
  "id": "corte-da-minoria",
  "version": "0.1.0",
  "name": { "pt-BR": "Corte da Minoria", "en": "Minority Court" },
  "description": {
    "pt-BR": "Uma cor secreta, dois salões e um trono que passa por todos: pontue sendo a minoria do salão para onde o rei te mandar.",
    "en": "One secret colour, two halls and a throne everyone takes a turn on: score by being the minority of the hall the king sends you to."
  },
  "minPlayers": 5,
  "maxPlayers": 15,
  "usesDealer": true,
  "estimatedMinutes": 15,
  "accent": "#2c5aa0",
  "config": [
    {
      "key": "tutorial",
      "type": "boolean",
      "label": { "pt-BR": "Tutorial (como jogar antes da eleição)", "en": "Tutorial (how to play before the election)" },
      "default": true
    },
    {
      "key": "colorMode",
      "type": "select",
      "label": { "pt-BR": "Escolher a cor", "en": "Choose your colour" },
      "options": [
        { "value": "phone", "label": { "pt-BR": "No celular", "en": "On the phone" } },
        { "value": "dealer", "label": { "pt-BR": "No Dealer", "en": "At the Dealer" } }
      ],
      "default": "phone"
    },
    {
      "key": "electionSeconds",
      "type": "number",
      "label": { "pt-BR": "Eleição do rei (s)", "en": "King election (s)" },
      "min": 20, "max": 120, "step": 5, "default": 45
    },
    {
      "key": "colorSeconds",
      "type": "number",
      "label": { "pt-BR": "Escolha de cor no celular (s)", "en": "Colour choice on the phone (s)" },
      "min": 10, "max": 120, "step": 5, "default": 30
    },
    {
      "key": "dealerColorSeconds",
      "type": "number",
      "label": { "pt-BR": "Escolha de cor no Dealer (s)", "en": "Colour choice at the Dealer (s)" },
      "min": 60, "max": 900, "step": 30, "default": 300
    },
    {
      "key": "divideSeconds",
      "type": "number",
      "label": { "pt-BR": "Divisão do rei (s)", "en": "King's split (s)" },
      "min": 30, "max": 300, "step": 10, "default": 120
    },
    {
      "key": "passSeconds",
      "type": "number",
      "label": { "pt-BR": "Janela do Passe Real (s)", "en": "Royal Pass window (s)" },
      "min": 10, "max": 60, "step": 5, "default": 20
    },
    {
      "key": "revealSeconds",
      "type": "number",
      "label": { "pt-BR": "Revelação (s)", "en": "Reveal (s)" },
      "min": 5, "max": 30, "step": 1, "default": 8
    },
    {
      "key": "successorSeconds",
      "type": "number",
      "label": { "pt-BR": "Escolha do sucessor (s)", "en": "Choosing the heir (s)" },
      "min": 10, "max": 120, "step": 5, "default": 30
    }
  ]
}
