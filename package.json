{
  "name": "multiplayer-plataform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev:relay": "npm run dev -w @mp/relay",
    "dev:web": "npm run build:rive && npm run dev -w @mp/web",
    "build": "npm run build:rive && npm run build:games && npm run build -w @mp/web",
    "build:games": "node scripts/build-games.mjs",
    "build:rive": "node scripts/build-rive.mjs",
    "deploy": "npm run build && npm run deploy -w @mp/relay",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/relay",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
